# ─────────────────────────────────────────────────────────────────────────────
# AntiBugBot — configuration
# Copy to .env  →  cp .env.example .env
# Every value below is a default; command line flags beat these.
# ─────────────────────────────────────────────────────────────────────────────

# ── The rule that matters ────────────────────────────────────────────────────
# Anything strictly longer than this many characters is treated as a crash-bug
# payload: it gets deleted for you, the sender is blocked, reports are filed and
# your own number gets a full incident brief.
THRESHOLD_CHARS=2000

# How the length is measured: max (default, the larger of the two), grapheme
# (what your eyes see — emoji clusters count once), utf16 (what the wire carries),
# codepoints. Invisible-character attacks are why `max` is the default.
COUNT_MODE=max

# Also police the sneaky payloads that are short but still crash renderers:
# zero-width/bidi inflation, unicode tag blocks, ZWJ bombs, control characters,
# malformed UTF-16. Set false for length-only policing.
HEURISTICS=true

# Some bug payloads repeat the same string across caption + formatted caption + title
# + footer so every renderer lays it out again. Count those duplicates too.
COUNT_PAYLOAD=false

# ── Enforcement ─────────────────────────────────────────────────────────────
BLOCK_ENABLED=true
# for-me            → real "delete for me" (device + linked devices) — recommended
# revoke-if-able    → tries "delete for everyone" first, falls back to for-me
# off               → leave the message alone
DELETE_MODE=for-me

# ── Reporting ───────────────────────────────────────────────────────────────
# Number of report submissions per incident.
REPORT_ATTEMPTS=30
# auto | native | bridge | evidence | off
#   auto     → use whatever real report path this client actually has, else evidence
#   native   → socket method (some Baileys forks expose reportAbuse)
#   bridge   → your own WhatsApp-Web/wppconnect bridge that has a report endpoint
#   evidence → write a submittable evidence packet to data/reports/ and tell you
REPORT_CHANNEL=auto
# Pacing between submissions, so the shield never looks like a spammer itself.
REPORT_MIN_INTERVAL_MS=700
REPORT_JITTER_MS=350
REPORT_TIMEOUT_MS=15000
# One-off startup check for a raw report stanza the server will accept (safe, but
# set false if you want zero extra traffic).
REPORT_PROBE_IQ=true
# Optional bridge: POST ${WA_BRIDGE_URL}/report  and  GET ${WA_BRIDGE_URL}/health
WA_BRIDGE_URL=
WA_BRIDGE_TOKEN=

# ── Scope ───────────────────────────────────────────────────────────────────
# What to do inside group chats: enforce (act on the member), observe (log + brief
# only, never touch the chat — default), ignore (don't even look).
GROUPS_MODE=observe
# observe = detect and alert only, no delete/block/report (a safe dry run)
SHIELD_MODE=enforce
# Numbers that must never be enforced against (comma separated). Local numbers are
# expanded with COUNTRY_CODE.
WHITELIST=
# Where the incident brief goes. Empty = message-yourself chat on this account.
OWNER_NUMBER=
# Used to expand 077… into 9477…
COUNTRY_CODE=LK

# ── Own-account safety ───────────────────────────────────────────────────────
# Hard ceiling on enforcement actions per minute (reports included). If the account
# is being flooded, a breaker pauses enforcement for 5 minutes rather than letting
# WhatsApp see you as a spammer.
MAX_ACTIONS_PER_MINUTE=6

# ── Runtime ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info            # silent | error | warn | info | debug
LOG_FILE=true             # append to data/logs/bot.log
STATS_PANEL=true          # live status strip at the bottom of the terminal
BEEP_ON_THREAT=true       # terminal bell when something lands
WELCOME_MESSAGE=true      # send yourself an "armed" notice on connect
NOTIFY_ON=threats         # threats | everything (also sends non-threat chatter)
AUTH_DIR=auth
DATA_DIR=data
KEEP_ALIVE_MS=30000
RECONNECT_MAX_DELAY_MS=30000
# Pin the WhatsApp multidevice protocol version Baileys advertises (advanced;
# leave blank to use the library default). Example: 2.3000.99999999990007
BAILEYS_VERSION=
